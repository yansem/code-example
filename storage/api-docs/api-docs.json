{
    "openapi": "3.0.0",
    "info": {
        "title": "My Application API",
        "description": "API documentation for My Application",
        "contact": {
            "name": "API Support",
            "url": "https://example.com/support",
            "email": "support@example.com"
        },
        "version": "1.0.0"
    },
    "paths": {
        "/api/auth/register": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Регистрация пользователя",
                "description": "Создаёт нового пользователя и возвращает API-токен (Sanctum)",
                "operationId": "register",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RegisterRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Успешная регистрация",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "required": [
                                        "token"
                                    ],
                                    "properties": {
                                        "token": {
                                            "type": "string",
                                            "example": "1|randomlongtokenhere1234567890"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Ошибка валидации",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        },
                                        "errors": {
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/auth/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Логин пользователя",
                "description": "Логин пользователя и возвращение API-токена (Sanctum)",
                "operationId": "login",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LoginRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Успешный логин",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "required": [
                                        "token"
                                    ],
                                    "properties": {
                                        "token": {
                                            "type": "string",
                                            "example": "1|randomlongtokenhere1234567890"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Ошибка валидации",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        },
                                        "errors": {
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/auth/logout": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Логаут пользователя",
                "description": "Логаут пользователя и удаление API-токена (Sanctum)",
                "operationId": "logout",
                "responses": {
                    "204": {
                        "description": "Успешный логаут"
                    }
                }
            }
        },
        "/api/parkings": {
            "post": {
                "tags": [
                    "ParkingSession"
                ],
                "summary": "store parking",
                "description": "store parking",
                "operationId": "e695faaf3f2d6470ac8c87f62b5221c1",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ParkingSessionRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Created"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationErrorsResponse"
                    }
                }
            }
        },
        "/api/parkings/calculate": {
            "post": {
                "tags": [
                    "ParkingSession"
                ],
                "summary": "Расчёт стоимости парковки",
                "description": "Расчёт стоимости парковки",
                "operationId": "a1a4e6d4b8e61be755c0f2090064e955",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ParkingSessionCalculateRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Успешный расчёт стоимости",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "cost": {
                                            "description": "Стоимость парковки в копейках",
                                            "type": "integer",
                                            "format": "int64",
                                            "example": 1250
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationErrorsResponse"
                    }
                }
            }
        },
        "/api/parkings/{id}/cancel": {
            "post": {
                "tags": [
                    "ParkingSession"
                ],
                "summary": "Отмена парковки",
                "description": "Отмена парковки",
                "operationId": "a98a8ae596370ede25906a5b28dc7498",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "parking session id",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        },
                        "example": "1"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Успешная отмена парковки"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationErrorsResponse"
                    }
                }
            }
        },
        "/api/vehicles": {
            "post": {
                "tags": [
                    "Vehicle"
                ],
                "summary": "store vehicle",
                "description": "store vehicle",
                "operationId": "a88e0bca4193c91e713d0441659d199c",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/VehicleRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Created"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationErrorsResponse"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "LoginRequest": {
                "required": [
                    "email",
                    "password"
                ],
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "ivan@mail.ru",
                        "maxLength": 255
                    },
                    "password": {
                        "type": "string",
                        "format": "password",
                        "example": "Password123!",
                        "minLength": 8
                    }
                },
                "type": "object"
            },
            "RegisterRequest": {
                "required": [
                    "name",
                    "surname",
                    "email",
                    "phone",
                    "password",
                    "password_confirmation"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "example": "Иван",
                        "maxLength": 255,
                        "minLength": 2
                    },
                    "surname": {
                        "type": "string",
                        "example": "Иванов",
                        "maxLength": 255,
                        "minLength": 2
                    },
                    "patronymic": {
                        "type": "string",
                        "example": "Иванович",
                        "maxLength": 255,
                        "minLength": 2
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "ivan@mail.ru",
                        "maxLength": 255
                    },
                    "phone": {
                        "type": "string",
                        "example": "+79991234567"
                    },
                    "password": {
                        "type": "string",
                        "format": "password",
                        "example": "Password123!",
                        "minLength": 8
                    },
                    "password_confirmation": {
                        "type": "string",
                        "format": "password",
                        "example": "Password123!"
                    }
                },
                "type": "object"
            },
            "VehicleRequest": {
                "required": [
                    "license_plate",
                    "is_default",
                    "is_foreign",
                    "vehicle_category_id"
                ],
                "properties": {
                    "license_plate": {
                        "description": "Номерной знак. Формат зависит от значения is_foreign",
                        "type": "string",
                        "pattern": "^[A-Z0-9\\s-]{5,12}$",
                        "example": "А123ЕВ456",
                        "maxLength": 12,
                        "minLength": 5
                    },
                    "is_default": {
                        "description": "Является ли это транспортное средство основным",
                        "type": "boolean",
                        "example": false
                    },
                    "is_foreign": {
                        "description": "Иностранный номер (true) или российский (false)",
                        "type": "boolean",
                        "example": false
                    },
                    "vehicle_category_id": {
                        "description": "ID категории ТС",
                        "type": "integer",
                        "example": 1
                    }
                },
                "type": "object"
            },
            "ValidationErrors": {
                "required": [
                    "message",
                    "errors"
                ],
                "properties": {
                    "message": {
                        "type": "string"
                    },
                    "errors": {
                        "type": "object",
                        "example": {
                            "field": [
                                "string"
                            ]
                        }
                    }
                },
                "type": "object"
            },
            "ParkingSessionCalculateRequest": {
                "required": [
                    "duration",
                    "vehicle_id",
                    "zone_id"
                ],
                "properties": {
                    "duration": {
                        "description": "Длительность в минутах",
                        "type": "integer",
                        "example": "60"
                    },
                    "vehicle_id": {
                        "description": "ID транспортного средства",
                        "type": "integer",
                        "example": 12
                    },
                    "zone_id": {
                        "description": "ID парковочной зоны",
                        "type": "integer",
                        "example": 5
                    }
                },
                "type": "object"
            },
            "ParkingSessionRequest": {
                "required": [
                    "duration",
                    "is_auto_renewal",
                    "vehicle_id",
                    "zone_id"
                ],
                "properties": {
                    "duration": {
                        "description": "Длительность в минутах",
                        "type": "integer",
                        "example": "60"
                    },
                    "is_auto_renewal": {
                        "description": "Продление существующей парковки",
                        "type": "boolean",
                        "example": false
                    },
                    "vehicle_id": {
                        "description": "ID транспортного средства",
                        "type": "integer",
                        "example": 12
                    },
                    "zone_id": {
                        "description": "ID парковочной зоны",
                        "type": "integer",
                        "example": 5
                    }
                },
                "type": "object"
            }
        },
        "responses": {
            "ValidationErrorsResponse": {
                "description": "Validation errors",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/ValidationErrors"
                        }
                    }
                }
            }
        },
        "securitySchemes": {
            "sanctum": {
                "type": "apiKey",
                "description": "Enter token in format (Bearer <token>)",
                "name": "Authorization",
                "in": "header"
            }
        }
    },
    "tags": [
        {
            "name": "Auth",
            "description": "Auth"
        },
        {
            "name": "ParkingSession",
            "description": "ParkingSession"
        },
        {
            "name": "Vehicle",
            "description": "Vehicle"
        }
    ],
    "security": [
        {
            "sanctum": []
        }
    ]
}